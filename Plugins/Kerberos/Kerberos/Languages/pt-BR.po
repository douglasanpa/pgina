msgid "Realm:"
msgstr "Realm:"

msgid "Save"
msgstr "Salvar"

msgid "Enter the target Kerberos realm name ex: REALM.UTAH.EDU"
msgstr "Informe o realm Kerberos, ex.: REALM.EXEMPLO.EDU"

msgid "Cancel"
msgstr "Cancelar"

msgid "Help"
msgstr "Ajuda"

msgid "KRB5 Realm Configuration"
msgstr "Configuração do realm KRB5"

msgid "Failed to contact authenticating kerberos authority."
msgstr "Não foi possível conectar ao servidor de autenticação do Kerberos."

msgid "Failed due to bad password and/or user name."
msgstr "Falhou: usuário ou senha incorretos."

msgid "Failed due to bad kerberos Security Principal Name."
msgstr "Falhou: o nome principal (SPN) do Kerberos é inválido."

msgid "Success"
msgstr "Sucesso"

msgid "Failed to authenticate due to unknown error."
msgstr "A autenticação falhou por um erro desconhecido."
