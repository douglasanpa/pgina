"Project-Id-Version: pGina\n"
"Language: pt_BR\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"

msgid ""
"No Username supplied\n"
"\n"
"'{0}' was entered and parsed to '{1}'"
msgstr ""
"Nenhum usuário informado\n"
"\n"
"Foi digitado '{0}', interpretado como '{1}'"

msgid ""
"Still logoff work to do for user {0}\n"
"Wait a few seconds and retry"
msgstr ""
"O logoff do usuário {0} ainda não terminou\n"
"Aguarde alguns segundos e tente de novo"

msgid ""
"No Domainname supplied\n"
"\n"
"'{0}' was entered and parsed to '{1}'"
msgstr ""
"Nenhum domínio informado\n"
"\n"
"Foi digitado '{0}', interpretado como '{1}'"

msgid "Unknown username or bad password"
msgstr "Usuário desconhecido ou senha incorreta"

msgid ""
"User {0} is Locked in Session {1} but the username doesn't match the session information pGina contains\n"
"\n"
"'{0}' vs '{2}'"
msgstr ""
"O usuário {0} está bloqueado na sessão {1}, mas o nome não confere com o que o pGina registrou para a sessão\n"
"\n"
"'{0}' x '{2}'"

msgid ""
"User {0} is Locked in Session {1} but was not authenticated by pGina\n"
"\n"
"It is possible that another Credential Provider was used\n"
"or the pGina service has crashed.\n"
msgstr ""
"O usuário {0} está bloqueado na sessão {1}, mas não entrou pelo pGina\n"
"\n"
"Talvez outro provedor de credenciais tenha sido usado\n"
"ou o serviço do pGina tenha sido reiniciado.\n"

msgid ""
"There is a program running as {0} but it wasn't started with pGina.\n"
"I can't log you in because this would conflict with the current running process.\n"
"\n"
"Session in which a process is running:\n"
"{1}"
msgstr ""
"Há um programa rodando como {0} que não foi iniciado pelo pGina.\n"
"Não é possível entrar, porque isso entraria em conflito com esse processo.\n"
"\n"
"Sessão em que o processo está rodando:\n"
"{1}"

msgid "Bad password"
msgstr "Senha incorreta"

msgid "Password incorrect!"
msgstr "Senha incorreta!"

msgid "Internal error"
msgstr "Erro interno"

msgid "Remote({0}) Error:{1}\n\n"
msgstr "Remoto ({0}), erro: {1}\n\n"
